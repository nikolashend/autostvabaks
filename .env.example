APP_NAME=Autostvabaks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://autostvabaks.ee

APP_LOCALE=et
APP_FALLBACK_LOCALE=et
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autostvabaks
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@autostvabaks.ee"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# E-mail, kuhu saadetakse uued paringud (varuvaartus; pohivaartus on admin-paneeli seadetes)
LEADS_MAIL_TO=alan@autostvabaks.ee

# Testovyj domen: true = robots.txt Disallow + noindex na vseh stranicah
SITE_NOINDEX=false
# Testovyj domen: "user:password" zakryvaet ves' sait HTTP Basic Auth (na prode ostavit' pustym)
STAGING_AUTH=

# Brand tokens (hex). Prototype lime by default; approved brand is applied in Stage 2 (see docs/autostvabaks).
# BRAND_PRIMARY=#70f46d
# BRAND_INK=#101010

# --- Stage 3 release gates & integrations (see config/autostvabaks.php) ---
# Human sign-offs: production release is blocked unless both are "approved".
HERO_ASSET_STATUS=approved
LEGAL_CONTENT_STATUS=draft
# Google Tag Manager container (GTM-XXXXXXX); injected on the production host only unless ANALYTICS_ENABLED=true
ANALYTICS_GTM_ID=
ANALYTICS_ENABLED=
# Content-Security-Policy for public pages: off | report-only | enforce
CSP_MODE=report-only
# Serve minified twins built by `node scripts/build-assets.cjs`
ASSETS_MINIFIED=true
# Total size of lead photos attached to the notification e-mail (the rest stays in the admin panel)
LEADS_MAIL_ATTACHMENTS_MAX_MB=10
